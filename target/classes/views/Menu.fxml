<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: beige;" styleClass="col" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.tictactoe.gui.controller.IntroController">
   <children>
      <Button layoutX="47.0" layoutY="224.0" mnemonicParsing="false" onAction="#startSmartSingleplayer" prefHeight="40.0" prefWidth="121.0" text="vs SmartAI" textFill="#686aff" focusTraversable="false">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="47.0" layoutY="276.0" mnemonicParsing="false" onAction="#startMultiplayer" prefHeight="40.0" prefWidth="121.0" text="Multiplayer" textFill="RED" focusTraversable="false">
