<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane focusTraversable="true" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.tictactoe.gui.controller.IntroController">
   <children>
      <Button fx:id="btnSingle" layoutX="110.0" layoutY="200.0" mnemonicParsing="false" onAction="#startSingleplayer" text="Singeplayer">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button fx:id="btnMulti" layoutX="383.0" layoutY="200.0" mnemonicParsing="false" onAction="#startMultiplayer" text="Multiplayer">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Label alignment="CENTER" layoutX="110.0" layoutY="84.0" text="Welcome To TicTacToe" textAlignment="CENTER">
         <font>
            <Font size="36.0" />
         </font>
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
      </Label>
   </children>
</AnchorPane>
